#!/usr/bin/python3 -I
"""roxy-switch-color blue|green: point nginx at one Roxy color, test the config, reload (the blue/green switch).

What this is
    A root-owned wrapper installed as /usr/local/sbin/roxy-switch-color (root, 0755). deploy.sh and
    deploy_rollback.sh run it through sudo as `sudo /usr/local/sbin/roxy-switch-color <color>`; the sudo rules
    allow exactly `blue` and `green` as the argument (deploy/sudoers/roxy-deploy). It repoints the symlink
    /etc/nginx/roxy-active-upstream.conf at roxy-upstream-<color>.conf, runs `nginx -t`, and reloads nginx; on a
    failed test it puts the symlink back. With `--boot` (used only by roxy-boot.service, as root) it starts the
    color the symlink points at instead.

Why it exists
    Plan 9.14 and 17.4 step 6: the deploy user may not write anything under /etc/nginx, because nginx config runs
    as root. Repointing one symlink between two root-owned, reviewed files is the only nginx change a deploy
    needs, so this wrapper does exactly that and nothing else. A reload is a zero downtime switch: nginx starts
    new workers that send new requests to the new color, and old workers finish the old color's connections.

How it works
    The new link is created under a temporary name and renamed over the old one (rename is atomic, so nginx never
    sees a missing file). Both upstream files must be root-owned regular files that nobody else can write. The
    same lock file as roxy-nginx-apply serializes the two wrappers. All paths come from a `Layout`, so tests run
    the functions against a temporary tree.

What to read next
    deploy/nginx/roxy-upstream-blue.conf (what the symlink selects), deploy/tools/roxy-nginx-apply, then
    deploy/deploy.sh (steps 6 and 7, and the rollback on failure).
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import os
import stat
import subprocess
import sys
from collections.abc import Iterator
from dataclasses import dataclass
from pathlib import Path


def say(text: str) -> None:
    """One line on stdout (the journal or the deploy log). A function, not print, so output is explicit."""
    sys.stdout.write(text + "\n")
    sys.stdout.flush()


def warn(text: str) -> None:
    """One line on stderr."""
    sys.stderr.write(text + "\n")
    sys.stderr.flush()


COLORS = ("blue", "green")


class SwitchError(RuntimeError):
    """A refusal with a message for the operator."""


@dataclass(frozen=True)
class Layout:
    """Paths and programs. Production values are the defaults; tests pass their own."""

    nginx_dir: Path = Path("/etc/nginx")
    state_dir: Path = Path("/var/lib/roxy-nginx-apply")
    nginx_cmd: tuple[str, ...] = ("/usr/sbin/nginx",)
    systemctl_cmd: tuple[str, ...] = ("/usr/bin/systemctl",)
    trusted_uid: int = 0

    @property
    def active_link(self) -> Path:
        return self.nginx_dir / "roxy-active-upstream.conf"

    def upstream_file(self, color: str) -> Path:
        return self.nginx_dir / f"roxy-upstream-{color}.conf"


def log(message: str) -> None:
    """One line on stdout for the deploy log."""
    say(f"roxy-switch-color: {message}")


def proc(cmd: list[str]) -> subprocess.CompletedProcess[bytes]:
    """Run a command with a fixed minimal environment."""
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}
    return subprocess.run(cmd, capture_output=True, env=env, check=False)  # noqa: S603


@contextlib.contextmanager
def locked(layout: Layout) -> Iterator[None]:
    """One switch or apply at a time (the lock file is shared with roxy-nginx-apply)."""
    layout.state_dir.mkdir(mode=0o755, parents=True, exist_ok=True)
    with open(layout.state_dir / "lock", "a", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def check_upstream_file(path: Path, trusted_uid: int) -> None:
    """The file the symlink will select must be a root-owned regular file nobody else can write."""
    try:
        info = path.lstat()
    except OSError as exc:
        raise SwitchError(f"{path} is missing (run roxy-nginx-apply first): {exc.strerror}") from exc
    if not stat.S_ISREG(info.st_mode):
        raise SwitchError(f"{path} must be a regular file")
    if info.st_uid != trusted_uid or info.st_mode & 0o022:
        raise SwitchError(f"{path} must be owned by uid {trusted_uid} and not writable by group or others")


def active_color(layout: Layout) -> str | None:
    """The color the symlink points at, or None when there is no (valid) symlink."""
    try:
        target = os.readlink(layout.active_link)
    except OSError:
        return None
    for color in COLORS:
        if Path(target).name == f"roxy-upstream-{color}.conf":
            return color
    return None


def replace_symlink(link: Path, target: Path) -> None:
    """Point `link` at `target` atomically."""
    tmp = link.with_name(f".{link.name}.new")
    with contextlib.suppress(FileNotFoundError):
        tmp.unlink()
    os.symlink(target, tmp)
    os.replace(tmp, link)


def switch(layout: Layout, color: str) -> None:
    """Repoint, test, reload; restore the previous symlink when the test fails."""
    if color not in COLORS:
        raise SwitchError("the color must be blue or green")
    check_upstream_file(layout.upstream_file(color), layout.trusted_uid)
    if layout.active_link.exists() and not layout.active_link.is_symlink():
        raise SwitchError(f"{layout.active_link} exists but is not a symlink; fix it by hand")
    with locked(layout):
        previous = os.readlink(layout.active_link) if layout.active_link.is_symlink() else None
        replace_symlink(layout.active_link, layout.upstream_file(color))
        tested = proc([*layout.nginx_cmd, "-t"])
        if tested.returncode != 0:
            if previous is None:
                layout.active_link.unlink(missing_ok=True)
            else:
                replace_symlink(layout.active_link, Path(previous))
            output = (tested.stderr + tested.stdout).decode("utf-8", "replace").strip()
            raise SwitchError(f"nginx -t failed; the previous color was restored:\n{output}")
        reloaded = proc([*layout.systemctl_cmd, "reload", "nginx"])
        if reloaded.returncode != 0:
            output = reloaded.stderr.decode("utf-8", "replace").strip()
            raise SwitchError(f"systemctl reload nginx failed: {output}")
    log(f"nginx now sends traffic to {color}")


def boot(layout: Layout) -> None:
    """At boot: start the color nginx points at (roxy-boot.service)."""
    color = active_color(layout)
    if color is None:
        log("no active color yet (nothing deployed); nothing to start")
        return
    started = proc([*layout.systemctl_cmd, "start", f"roxy@{color}.service"])
    if started.returncode != 0:
        raise SwitchError(f"systemctl start roxy@{color}.service failed: {started.stderr.decode('utf-8', 'replace')}")
    log(f"started roxy@{color}.service")


def main(argv: list[str] | None = None, layout: Layout | None = None) -> int:
    parser = argparse.ArgumentParser(prog="roxy-switch-color", description="Point nginx at a Roxy color.")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("color", nargs="?", choices=COLORS, help="the color to send traffic to")
    group.add_argument("--boot", action="store_true", help="start the active color (roxy-boot.service)")
    args = parser.parse_args(argv)
    try:
        if args.boot:
            boot(layout or Layout())
        else:
            switch(layout or Layout(), args.color)
    except SwitchError as exc:
        warn(f"roxy-switch-color: {exc}")
        return 1
    return 0


if __name__ == "__main__":
    if os.geteuid() != 0:
        warn("roxy-switch-color: must run as root (through sudo)")
        raise SystemExit(1)
    raise SystemExit(main())
