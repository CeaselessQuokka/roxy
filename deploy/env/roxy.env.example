# roxy.env.example: shared, NON-SECRET configuration for both Roxy colors (plan 9.8, 15.3 L).
#
# Install as /etc/roxy/roxy.env, owner root, group roxy, mode 0640. systemd reads it before /etc/roxy/<color>.env
# (EnvironmentFile= in roxy@.service), so a color file can override a value here. Changing a value needs a restart
# of the colors (a deploy does that). Secrets NEVER go here: they are systemd credentials in /etc/roxy/credentials/
# (plan 9.8). roxy-nginx-apply also reads this file (as root) for the site origin and the deploy repository, and
# refuses it unless root owns it and nobody else can write it.
# Format: KEY=VALUE, one per line, no shell syntax (systemd does not expand variables or run commands here).

# production: Secure cookies and no auto-migrate; development is only for a laptop.
ROXY_ENV=production

# gunicorn worker processes per color. 2 for the 2 vCPU server (D2); each worker is an asyncio event loop.
ROXY_WORKERS=2

# Recycle a worker after this many requests (0 disables), insurance against slow memory growth (plan 4.7 row 110).
ROXY_MAX_REQUESTS=20000

# How many proxies in front of the app append to X-Forwarded-For. 1 = nginx only. Set 2 behind a CDN, and add the
# CDN's address ranges to ROXY_TRUSTED_PROXY_CIDRS (plan 9.11).
ROXY_TRUSTED_PROXY_HOPS=1

# Socket peers whose X-Forwarded-For is believed: nginx on loopback.
ROXY_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# 0: nginx sends HSTS (deploy/nginx/snippets/roxy-security-headers.conf); the app sending it too would duplicate it.
ROXY_SEND_HSTS=0

# Log verbosity: debug, info, warning, error or critical (third-party HTTP libraries stay at warning regardless).
ROXY_LOG_LEVEL=info

# Databases, snapshots, exports and audit results (systemd creates it: StateDirectory=roxy).
ROXY_STATE_DIR=/var/lib/roxy

# The public origin: links in alert emails, CSRF origin checks, and the nginx server_name and redirect target.
ROXY_SITE_ORIGIN=https://roxytheproxy.com

# Optional: nginx server names (space separated) when they are not "<host> www.<host>" of ROXY_SITE_ORIGIN.
# ROXY_NGINX_SERVER_NAMES=roxytheproxy.com www.roxytheproxy.com

# The rotator exit IP probe target (plan 8.2).
ROXY_ROTATOR_IP_ECHO_URL=https://api.ipify.org?format=json

# The repository roxy-nginx-apply fetches to verify that a deployed commit is on the branch below (plan 9.14).
# Replace OWNER/REPO with the GitHub repository; the wrapper refuses to run while this placeholder is here.
ROXY_DEPLOY_REPO_URL=https://github.com/OWNER/REPO.git

# The branch every deployed commit must be on.
ROXY_DEPLOY_BRANCH=main

# Optional off-box backups (D15): the rclone remote NAME only (its keys are the rclone_config credential).
# ROXY_BACKUP_REMOTE=offsite

# 1 also backs up hot.db (limiter state and leases; disposable, so off by default, plan 17.1).
ROXY_BACKUP_HOT=0

# Optional: a file of age public keys (one per line); when it exists backups are encrypted with them. Public keys
# are not secrets; the private key stays offline with the owner (plan 9.8 key escrow).
ROXY_BACKUP_AGE_RECIPIENTS=/etc/roxy/backup-age-recipients
