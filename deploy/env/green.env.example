# green.env.example: the values that make a Roxy process the GREEN color (plan 17.1, 17.3).
#
# Install as /etc/roxy/green.env, owner root, group roxy, mode 0640. roxy@green.service reads it after
# /etc/roxy/roxy.env, so these values win. The ports are fixed in deploy/nginx/roxy-upstream-green.conf too; change
# both together or the switch would send traffic to the wrong port.

# Which slot this process is; the app reports it in /internal/version and the heartbeat table.
ROXY_COLOR=green

# The loopback address nginx proxies to when green is active. Set directly here: systemd cannot build it from a
# variable inside Environment= (plan 17.1).
ROXY_BIND=127.0.0.1:8002

# The internal Unix socket for the deploy health gate and ctl.py (plan 5.8). It must live in /run/roxy-green, the
# unit's RuntimeDirectory, so systemd creates and removes it with the right owner and mode.
ROXY_INTERNAL_SOCKET=/run/roxy-green/internal.sock
