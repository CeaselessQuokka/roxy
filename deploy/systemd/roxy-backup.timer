# roxy-backup.timer: runs roxy-backup.service every night (plan 17.1).

[Unit]
# Shown in `systemctl list-timers`.
Description=Nightly Roxy backup

[Timer]
# 03:30 local time, a quiet hour for Roblox game traffic in the owner's time zone.
OnCalendar=*-*-* 03:30:00
# Up to 15 minutes later at random, so the backup never lines up with other nightly jobs on the box.
RandomizedDelaySec=15m
# If the server was off at 03:30, run once soon after boot instead of skipping the night.
Persistent=true
# One-minute precision is plenty and lets systemd batch wakeups.
AccuracySec=1m
# The service this timer starts.
Unit=roxy-backup.service

[Install]
# Active from boot once enabled.
WantedBy=timers.target
